{
	"name": "nith-results-web-app",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@10.16.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write ."
	},
	"imports": {
		"#lib/*.svelte": "./src/lib/*.svelte",
		"#lib/*": "./src/lib/*.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@typescript-eslint/eslint-plugin": "^8.72.0",
		"@typescript-eslint/parser": "^8.72.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.106.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-preprocess": "^6.0.5",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.5"
	},
	"files": [
		"src/lib/server/deatiled_result.json",
		"src/lib/server/ranks_result.json",
		"src/lib/server/result_config.json"
	],
	"type": "module"
}